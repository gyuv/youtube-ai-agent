// Lumen Cloud: data model for the zero-cost YouTube automation pipeline.
//
// Database: Supabase PostgreSQL (free tier).
// The connection URL lives in prisma.config.ts (Prisma 7+), not in this file:
//   - DIRECT_URL   -> session/direct connection, used by the Prisma CLI for migrations
//   - DATABASE_URL -> transaction pooler (port 6543), used at runtime by the pg driver adapter

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

/// Lifecycle of a video through the cloud pipeline.
enum ProjectStatus {
  DRAFT             // topic chosen, nothing generated yet
  SCRIPTED          // Gemini script + scene breakdown stored
  ASSETS_READY      // every scene has voice audio and a visual
  QUEUED_FOR_RENDER // GitHub Actions workflow dispatched, runner not yet started
  RENDERING         // runner picked up the job (Remotion/FFmpeg in progress)
  RENDERED          // final .mp4 uploaded to storage
  PUBLISHED         // uploaded to YouTube; youtubeVideoId is set
  FAILED            // any stage failed; see lastError
}

/// Output canvas. Both render at 1080p.
enum VideoFormat {
  SHORT     // 9:16, 1080x1920
  LONG_FORM // 16:9, 1920x1080
}

/// Where a scene's active visual came from.
enum VisualSource {
  POLLINATIONS // keyless AI image generation
  PEXELS       // free stock photo or B-roll clip
  UPLOAD       // operator-supplied asset from the Repair Studio
  WAN2GP       // AI video clip generated by Wan2GP on a GPU worker (e.g. Google Colab)
  MUAPI        // AI image or video from Muapi.ai (paid, the engine behind Open-Higgsfield-AI)
}

/// Progress of a Wan2GP clip request. Null when the scene has none.
enum AiClipStatus {
  QUEUED  // waiting for a GPU worker to claim it
  RUNNING // a worker claimed it and is generating
  FAILED  // the worker reported an error; see aiClipError
}

enum PrivacyStatus {
  PRIVATE
  UNLISTED
  PUBLIC
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

/// A connected YouTube channel with its OAuth grant, content defaults, and posting schedule.
model Channel {
  id               String  @id @default(cuid())
  name             String
  youtubeChannelId String? @unique

  // Google OAuth2 grant for YouTube Data API v3.
  // Tokens are encrypted by the app (AES-256-GCM, TOKEN_ENCRYPTION_KEY) before they are
  // written, so a database leak alone does not expose the channel.
  oauthAccessTokenEnc  String?   @db.Text
  oauthRefreshTokenEnc String?   @db.Text
  oauthTokenExpiresAt  DateTime?
  oauthScopes          String[]

  // Content defaults applied to every new project on this channel.
  niche               String
  targetAudience      String?
  language            String      @default("en")
  defaultScriptPrompt String?     @db.Text // system prompt handed to Gemini
  defaultVisualPrompt String?     @db.Text // style suffix appended to every image prompt
  defaultVoice        String      @default("en-US-AriaNeural") // edge-tts voice ShortName
  defaultFormat       VideoFormat @default(SHORT)
  defaultPrivacy      PrivacyStatus @default(PRIVATE)

  // Posting schedule. postingCron is a standard 5-field cron evaluated in postingTimezone,
  // e.g. "0 18 * * 1,3,5" = 6pm on Mon/Wed/Fri.
  postingCron     String?
  postingTimezone String  @default("UTC")
  autoPublish     Boolean @default(false) // renderer uploads to YouTube directly when true
  isActive        Boolean @default(true)

  // Autopilot: fill upcoming posting slots without an operator.
  autopilot             Boolean      @default(false)
  autopilotReview       Boolean      @default(false) // stop at ASSETS_READY until an operator dispatches
  autopilotLeadHours    Int          @default(36) // how far ahead of a slot production starts
  autopilotVisualSource VisualSource @default(POLLINATIONS)
  topicBacklog          String?      @db.Text // one topic per line, used before Gemini ideas
  // Performance learning: Gemini's lessons from this channel's YouTube stats, fed into new topics and scripts.
  learnFromAnalytics    Boolean      @default(true)
  performanceNotes      String?      @db.Text
  performanceNotesAt    DateTime?

  projects VideoProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One video moving through script -> assets -> cloud render -> publish.
model VideoProject {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  topic  String
  status ProjectStatus @default(DRAFT)
  format VideoFormat   @default(SHORT)
  voice  String? // overrides Channel.defaultVoice when set

  // Structured Gemini output: { hook, sections[], cta, imagePrompts[], timestamps[] }.
  // Per-scene narration is normalised into Scene rows; this keeps the original for audit/regeneration.
  script Json?

  // YouTube metadata (generated by Gemini, editable in the studio).
  title       String?
  description String?       @db.Text
  tags        String[]
  privacy     PrivacyStatus @default(PRIVATE)

  // Every provider in the stack is free; kept to prove it and to catch accidental paid usage.
  cost Decimal @default(0.00) @db.Decimal(10, 2)

  // Cloud render tracking (GitHub Actions).
  renderRunId      String? // workflow run id, links the dashboard to the Actions log
  renderStartedAt  DateTime?
  renderFinishedAt DateTime?
  renderedVideoUrl String?
  thumbnailUrl     String?
  lastError        String?   @db.Text

  // Publishing.
  scheduledFor   DateTime? // next slot from the channel's posting schedule
  youtubeVideoId String?   @unique
  publishedAt    DateTime?
  // A studio/autopilot publish of an already-rendered video started; guards double uploads.
  publishStartedAt DateTime?
  // YouTube reported the upload as private although it should be (or become) visible. Unaudited
  // Google Cloud projects get every API upload locked private until the YouTube API audit passes.
  youtubeLocked    Boolean   @default(false)
  youtubeCheckedAt DateTime? // last time the video's visibility was read back from YouTube
  // YouTube statistics, refreshed daily by the autopilot for recently published videos.
  viewCount        Int?
  likeCount        Int?
  commentCount     Int?
  statsUpdatedAt   DateTime?

  // Created and advanced by the autopilot; it never touches operator-made projects.
  autopilot         Boolean @default(false)
  autopilotFailures Int     @default(0) // autopilot gives up on the project after 3

  scenes Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId, status])
  @@index([status, scheduledFor])
  @@index([autopilot, status])
}

/// A single narrated beat of a video: one voice clip over one visual.
model Scene {
  id        String       @id @default(cuid())
  projectId String
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sceneIndex Int // 0-based order within the project

  // Voiceover (edge-tts).
  narrationText String  @db.Text
  voiceAudioUrl String? // cleared when narrationText changes so stale audio is never rendered
  wordTimings   Json? // edge-tts word boundaries [{ word, startMs, endMs }] for burned-in captions

  // Visual (Pollinations image and/or Pexels B-roll). The renderer uses videoClipUrl when present,
  // otherwise imageUrl with a Ken Burns pan.
  visualPrompt String?      @db.Text
  stockQuery   String? // 2-4 word Pexels search phrase from the script
  imageUrl     String?
  videoClipUrl String?
  visualSource VisualSource @default(POLLINATIONS)

  // Wan2GP clip requests. The GPU worker polls for QUEUED scenes; until a clip arrives the
  // scene keeps its current visual, so a render never waits on the worker.
  aiClipStatus    AiClipStatus?
  aiClipPrompt    String?       @db.Text
  aiClipError     String?       @db.Text
  aiClipUpdatedAt DateTime?
  // Which engine makes the clip: null/"WAN2GP" (GPU worker polls) or "MUAPI" (the app polls Muapi).
  aiClipEngine    String?
  aiClipRequestId String? // Muapi prediction id while it renders

  durationSeconds Float   @default(0) // measured from the generated audio
  locked          Boolean @default(false) // locked scenes are skipped by bulk regeneration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, sceneIndex])
  @@index([aiClipStatus, aiClipUpdatedAt])
}

/// One autopilot step, shown as the activity feed on the dashboard. Pruned after 30 days.
model AutopilotEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String // planned | scripted | filled | dispatched | swept | error | idle
  level     String   @default("info") // info | error
  message   String   @db.Text
  channelId String?
  projectId String?

  @@index([createdAt])
}
