# Lumen Cloud: every value below comes from a free tier. Copy to .env for local dev and
# add the same keys in Vercel (Project Settings -> Environment Variables).

# ── Supabase PostgreSQL (Project Settings -> Database -> Connection string) ──
# Runtime: transaction pooler, port 6543 (serverless-safe).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Prisma CLI / migrations: session pooler or direct connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Media storage (voice clips, images, rendered .mp4) ──
# "supabase" (default): free tier caps each file at 50 MB, fine for Shorts.
# "r2": Cloudflare R2, 10 GB free with no egress fees; use it for long-form 1080p.
STORAGE_DRIVER="supabase"
# Raise only if your Supabase plan allows bigger files; the renderer sizes its bitrate to fit.
# STORAGE_MAX_OBJECT_MB="50"

# Supabase Storage: create a PUBLIC bucket with this name.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lumen-media"

# Cloudflare R2 (only when STORAGE_DRIVER="r2"): R2 -> Manage API tokens (Object Read & Write),
# and enable public access (r2.dev subdomain or a custom domain) for R2_PUBLIC_BASE_URL.
# R2_ACCOUNT_ID=""
# R2_BUCKET="lumen-media"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_BASE_URL="https://pub-<hash>.r2.dev"

# ── Gemini (https://aistudio.google.com/apikey, free tier) ──
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
# Used when the main model is rate limited (free-tier quotas are per model).
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# ── Pexels (https://www.pexels.com/api/, free) ──
PEXELS_API_KEY=""

# ── Pollinations.ai works without a key. A free token (register at pollinations.ai)
# raises the anonymous rate limit. Endpoint and model are overridable if their API moves.
POLLINATIONS_TOKEN=""
# POLLINATIONS_IMAGE_URL="https://image.pollinations.ai/prompt"
# POLLINATIONS_MODEL="flux"

# ── GitHub Actions cloud renderer ──
# Fine-grained PAT scoped to this repo only, with "Contents: read and write" (required by
# repository_dispatch) and "Actions: read" (lets the studio link to runs).
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPO_OWNER="gyuv"
GITHUB_REPO_NAME="youtube-ai-agent"
# Shared secret the runner sends when it calls /api/render/webhook (32+ chars: `openssl rand -hex 32`).
# Also add it, plus APP_URL (this app's https URL), as GitHub repository secrets.
RENDER_WEBHOOK_SECRET=""

# ── YouTube Data API v3 (Google Cloud Console -> OAuth client, type "Web application") ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
# YouTube category for uploads (22 = People & Blogs, 27 = Education, 28 = Science & Technology).
# YOUTUBE_CATEGORY_ID="22"

# 32-byte key (base64) used to encrypt OAuth tokens at rest: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=""
