# Lumen Cloud: every value below comes from a free tier. Copy to .env for local dev and
# add the same keys in Vercel (Project Settings -> Environment Variables).

# ── Supabase PostgreSQL (Project Settings -> Database -> Connection string) ──
# Runtime: transaction pooler, port 6543 (serverless-safe).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Prisma CLI / migrations: session pooler or direct connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Storage (audio, images, rendered .mp4) ──
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lumen-media"

# ── Gemini (https://aistudio.google.com/apikey, free tier) ──
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
# Used when the main model is rate limited (free-tier quotas are per model).
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# ── Pexels (https://www.pexels.com/api/, free) ──
PEXELS_API_KEY=""

# ── Pollinations.ai works without a key. A free token (register at pollinations.ai)
# raises the anonymous rate limit. Endpoint and model are overridable if their API moves.
POLLINATIONS_TOKEN=""
# POLLINATIONS_IMAGE_URL="https://image.pollinations.ai/prompt"
# POLLINATIONS_MODEL="flux"

# ── GitHub Actions cloud renderer ──
# Fine-grained PAT scoped to this repo only, with "Contents: read and write" (required by
# repository_dispatch) and "Actions: read" (lets the studio link to runs).
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPO_OWNER="gyuv"
GITHUB_REPO_NAME="youtube-ai-agent"
# Shared secret the runner sends back when it calls the render-status webhook.
RENDER_WEBHOOK_SECRET=""

# ── YouTube Data API v3 (Google Cloud Console -> OAuth client, type "Web application") ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"

# 32-byte key (base64) used to encrypt OAuth tokens at rest: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=""
